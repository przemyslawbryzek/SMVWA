# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=smvwa_user
DB_PASSWORD=smvwa_password
DB_NAME=smvwa_db

# ── Backend ──────────────────────────────────────────────────────────────────
# Public base URL used to build attachment URLs returned to the browser.
BACKEND_URL=http://localhost:3001
# Shared JWT secret used by backend and frontend auth cookie verification.
JWT_SECRET=change-this-to-a-long-random-secret

# ── Frontend ─────────────────────────────────────────────────────────────────
# Internal Docker URL used by the frontend server to talk to the backend API.
API_URL=http://backend:3001

