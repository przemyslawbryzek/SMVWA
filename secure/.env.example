# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=smvwa_user
DB_PASSWORD=smvwa_password
DB_NAME=smvwa_db

# ── Backend ──────────────────────────────────────────────────────────────────
# Public base URL used to build attachment URLs returned to the browser.
BACKEND_URL=http://localhost:3001

# ── Frontend ─────────────────────────────────────────────────────────────────
# Internal Docker URL used by the frontend server to talk to the backend API.
API_URL=http://backend:3001

# ── Shared ───────────────────────────────────────────────────────────────────
# Secret used to authenticate internal server-to-server calls.
# Must be identical in both the backend and frontend environments.
INTERNAL_SECRET=smvwa-internal-secret
