<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">All Users</h1>
    <% if (!users || users.length === 0) { %>
        <p class="text-gray-500">No users found.</p>
    <% } else { %>
    <table class="w-full border-collapse">
        <thead>
            <tr class="border-b border-stone-700 text-gray-400 text-sm text-left">
                <th class="py-2 pr-4">User</th>
                <th class="py-2 pr-4">Tag</th>
                <th class="py-2">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(u => { %>
            <tr class="border-b border-stone-800 hover:bg-stone-900" data-row>
                <td class="py-3 pr-4">
                    <div class="flex items-center gap-3">
                        <img src="<%= u.profile_image || 'https://via.placeholder.com/32' %>" class="size-8 rounded-full" alt="">
                        <a href="/profile/<%= u.id %>" class="font-semibold hover:underline"><%= u.username %></a>
                    </div>
                </td>
                <td class="py-3 pr-4 text-gray-400">@<%= u.tag || u.username %></td>
                <td class="py-3">
                    <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm"
                            data-admin-action="delete-user" data-id="<%= u.id %>">Delete</button>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>
</div>
