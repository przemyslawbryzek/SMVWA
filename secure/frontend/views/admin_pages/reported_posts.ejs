<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">Reported Posts</h1>
    <% if (!reportedPosts || reportedPosts.length === 0) { %>
        <p class="text-gray-500">No reported posts.</p>
    <% } else { %>
    <div class="flex flex-col gap-4">
        <% reportedPosts.forEach(r => { %>
        <div class="border border-stone-700 rounded-xl p-4 flex flex-col gap-3" data-row>
            <div class="flex items-center gap-3">
                <img src="<%= r.author_profile_image || 'https://via.placeholder.com/32' %>" class="size-8 rounded-full" alt="">
                <div>
                    <a href="/profile/<%= r.author_id %>" class="font-semibold hover:underline"><%= r.author_username %></a>
                    <span class="text-gray-500 text-sm ml-2">@<%= r.author_tag || r.author_username %></span>
                </div>
                <span class="ml-auto text-gray-500 text-xs">
                    <%= new Date(r.post_created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
            </div>
            <p class="text-gray-200 bg-stone-800 rounded-lg p-3"><%= r.post_content %></p>
            <div class="border border-red-900 rounded-lg p-3 bg-stone-900 text-sm flex flex-wrap gap-x-4 gap-y-1">
                <span><span class="text-red-400 font-semibold">Reason:</span> <%= r.reason %></span>
                <span class="text-gray-500">Reported by
                    <span class="text-gray-300"><%= r.reporter_username %></span>
                    (@<%= r.reporter_tag || r.reporter_username %>)
                </span>
                <span class="text-gray-500">
                    <%= new Date(r.reported_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
            </div>
            <div class="flex gap-2">
                <a href="/post/<%= r.post_id %>" target="_blank"
                   class="px-3 py-1 bg-stone-700 hover:bg-stone-600 text-white rounded-lg text-sm">View Post</a>
                <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm"
                        data-admin-action="delete-post" data-id="<%= r.post_id %>">Delete Post</button>
                <button class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm"
                        data-admin-action="dismiss-report" data-id="<%= r.report_id %>" data-report-type="post">Dismiss Report</button>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>
