<a href="/profile/<%-User.id %>" class="flex flex-row items-center gap-3 mt-4">
    <img class="size-10 rounded-full" src="<%= User.profile_image || 'https://via.placeholder.com/40' %>" alt="Profile Image">
    <div class="flex flex-col">
        <p><%- User.username %></p>
        <p class="text-gray-500"><%- User.email %></p>
    </div>
    <button data-user-id="<%= User.id %>" data-following="<%= User.isFollowing ? 'true' : 'false' %>" class="ml-auto px-3 py-1 rounded-full <%= User.isFollowing ? 'bg-green-500 text-white hover:bg-green-600' : 'bg-white text-black hover:bg-gray-200' %>">
        <%= User.isFollowing ? 'Following' : 'Follow' %>
    </button>
</a>