<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Reset Password</title>
</head>
<body class="bg-black text-white">
  <div class="flex flex-row h-screen w-screen">
    <div class="w-1/2 h-full flex items-center justify-center text-6xl font-bold">SMVWA</div>
    <div class="w-1/2 h-full flex flex-col justify-center gap-5">
      <h1 class="text-3xl">New Password</h1>

      <% if (error) { %>
        <div class="p-3 bg-red-900 text-white rounded w-1/2"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="p-3 bg-green-900 text-white rounded w-1/2"><%= success %></div>
        <a href="/login" class="text-blue-500 hover:underline text-sm">→ Go to Login</a>
      <% } else { %>
      <form action="/reset-password" method="POST" class="flex flex-col gap-3 w-1/2">
        <input type="hidden" name="token" value="<%= token %>">
        <div>
          <label class="text-sm text-gray-400 mb-1 block">Reset Token</label>
          <input type="text" name="token_display" value="<%= token %>" maxlength="6"
            class="p-2 rounded bg-black border border-white focus:outline-none focus:border-blue-500 w-full font-mono tracking-widest"
            oninput="document.querySelector('[name=token]').value = this.value">
        </div>
        <input type="password" name="new_password" placeholder="New Password"
          class="p-2 rounded bg-black border border-white focus:outline-none focus:border-blue-500" required>
        <button type="submit" class="p-2 rounded-full bg-white text-black hover:bg-gray-200">Reset Password</button>
      </form>
      <% } %>

      <a href="/forgot-password" class="text-blue-500 hover:underline text-sm">← Request new token</a>
    </div>
  </div>
</body>
</html>
