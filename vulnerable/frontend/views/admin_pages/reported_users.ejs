<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">Reported Users</h1>
    <% if (!reportedUsers || reportedUsers.length === 0) { %>
        <p class="text-gray-500">No reported users.</p>
    <% } else { %>
    <div class="flex flex-col gap-4">
        <% reportedUsers.forEach(r => { %>
        <div class="border border-stone-700 rounded-xl p-4 flex flex-col gap-3" data-row>
            <div class="flex items-center gap-3">
                <img src="<%= r.profile_image || 'https://via.placeholder.com/32' %>" class="size-8 rounded-full" alt="">
                <div>
                    <a href="/profile/<%= r.user_id %>" class="font-semibold hover:underline"><%= r.username %></a>
                    <span class="text-gray-500 text-sm ml-2">@<%= r.email %></span>
                </div>
            </div>
            <div class="border border-red-900 rounded-lg p-3 bg-stone-900 text-sm flex flex-wrap gap-x-4 gap-y-1">
                <span><span class="text-red-400 font-semibold">Reason:</span> <%= r.reason %></span>
                <span class="text-gray-500">Reported by
                    <span class="text-gray-300"><%= r.reporter_username %></span>
                    (<%= r.reporter_email %>)
                </span>
                <span class="text-gray-500">
                    <%= new Date(r.reported_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
            </div>
            <div class="flex gap-2">
                <a href="/profile/<%= r.user_id %>"
                   class="px-3 py-1 bg-stone-700 hover:bg-stone-600 text-white rounded-lg text-sm">View Profile</a>
                <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm"
                        data-admin-action="delete-user" data-id="<%= r.user_id %>">Delete User</button>
                <button class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm"
                        data-admin-action="dismiss-report" data-id="<%= r.report_id %>" data-report-type="user">Dismiss Report</button>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>
