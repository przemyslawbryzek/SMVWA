<div class="flex flex-row gap-5 items-center p-4 fixed top-0 w-full z-10 bg-black">
    <a href="/" class="font-bold p-2 rounded-full hover:bg-stone-900">←</a>
    <p class="text-2xl font-bold text-center">Post</p>
</div>
<div class="flex flex-row gap-5 items-center p-4">
    <a href="/" class="font-bold p-2 rounded-full hover:bg-stone-900">←</a>
    <p class="text-2xl font-bold text-center">Post</p>
</div>
<div id="thread-container">
    <% thread.forEach(post => { %>
        <%- include('../../components/postTemplate', { post }) %>
    <% }); %>
</div>
<div id="post-container">
    <%- include('../../components/postTemplate', { post }) %>
</div>
<%- include('../../components/postForm', { user, post }) %>
<div id="comments-container" class="flex flex-col">
    <% comments.forEach(post => { %>
        <%- include('../../components/postTemplate', { post }) %>
    <% }); %>
</div>