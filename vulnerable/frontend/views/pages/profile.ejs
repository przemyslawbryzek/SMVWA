<% if (!profileUser) { %>
    <div class="flex items-center justify-center h-screen">
        <div class="text-center">
            <h1 class="text-4xl font-bold mb-4">Profile not found</h1>
            <p class="text-gray-500 mb-6">The profile you're looking for doesn't exist or an error occurred.</p>
            <a href="/" class="px-4 py-2 rounded-full bg-white text-black hover:bg-gray-200">Go Home</a>
        </div>
    </div>
<% } else { %>
<%- include('../../components/pageHeader', { title: profileUser.username, backUrl: '/' }) %>
<div class="relative">
    <img id="background-image-display" class="w-full h-40 object-cover" src="<%= profileUser.background_image || 'https://about.canva.com/wp-content/uploads/sites/8/2019/03/gray.png' %>" alt="Background Image">
    <img id="profile-image-display" class="size-30 rounded-full absolute left-5 -bottom-10 border-4 border-black" src="<%= profileUser.profile_image || 'https://via.placeholder.com/80' %>" alt="Profile Image">
    <% if (isOwner) { %>
        <button id="edit-profile-btn" class="absolute right-5 -bottom-12 px-3 py-1 rounded-full border-stone-700 border-1 cursor-pointer hover:bg-stone-900">Edit Profile</button>
    <% } else { %>
        <button id="follow-btn" data-user-id="<%= profileUser.id %>" data-following="<%= isFollowing ? 'true' : 'false' %>" class="absolute right-5 -bottom-12 px-3 py-1 rounded-full cursor-pointer <%= isFollowing ? 'bg-green-500 text-white hover:bg-green-600' : 'bg-white text-black hover:bg-gray-200' %>">
            <%= isFollowing ? 'Following' : 'Follow' %>
        </button>
    <% } %>
</div>
<div class="mt-12 px-5 pb-5 border-b-1 border-stone-700">
    <h1 id="username-display" class="text-2xl font-bold"><%- profileUser.username %></h1>
    <p id="email-display" class="text-gray-500"><%- profileUser.email %></p>
    <p id="bio-display" class="mt-4"><%- profileUser.bio %></p>
    <div class="flex flex-row gap-5 mt-4">
        <p><span class="font-bold"><%- profileUser.following_count %></span> Following</p>
        <p><span class="font-bold"><%- profileUser.followers_count %></span> Followers</p>
    </div>
</div>

<% if (isOwner) { %>
<div id="edit-profile-modal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center">
    <div class="bg-stone-900 rounded-lg p-6 w-full max-w-lg mx-4">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold">Edit Profile</h2>
            <button id="close-modal-btn" class="text-2xl hover:text-gray-400">&times;</button>
        </div>
        
        <form id="edit-profile-form" class="flex flex-col gap-4">
            <div>
                <label class="block text-sm font-medium mb-2">Username</label>
                <input type="text" name="username" value="<%= profileUser.username %>" class="w-full p-2 bg-stone-800 rounded border border-stone-700 focus:outline-none focus:border-blue-500">
            </div>
            
            <div>
                <label class="block text-sm font-medium mb-2">Email</label>
                <input type="email" name="email" value="<%= profileUser.email %>" class="w-full p-2 bg-stone-800 rounded border border-stone-700 focus:outline-none focus:border-blue-500">
            </div>
            
            <div>
                <label class="block text-sm font-medium mb-2">Bio</label>
                <textarea name="bio" rows="3" class="w-full p-2 bg-stone-800 rounded border border-stone-700 focus:outline-none focus:border-blue-500"><%= profileUser.bio %></textarea>
            </div>
            
            <div>
                <label class="block text-sm font-medium mb-2">Profile Image</label>
                <input type="file" id="profile-image-input" accept="image/*" class="w-full p-2 bg-stone-800 rounded border border-stone-700">
                <div id="profile-image-preview" class="mt-2"></div>
            </div>
            
            <div>
                <label class="block text-sm font-medium mb-2">Background Image</label>
                <input type="file" id="background-image-input" accept="image/*" class="w-full p-2 bg-stone-800 rounded border border-stone-700">
                <div id="background-image-preview" class="mt-2"></div>
            </div>
            
            <div class="flex gap-3 justify-end mt-4">
                <button type="button" id="cancel-btn" class="px-4 py-2 rounded-full bg-stone-800 hover:bg-stone-700">Cancel</button>
                <button type="submit" class="px-4 py-2 rounded-full bg-white text-black hover:bg-gray-200">Save Changes</button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%- include('../../components/postsList', { posts: posts, containerId: 'posts-container' }) %>
<div id="scroll-sentinel" class="h-4"></div>
<div id="posts-loading" class="hidden p-4 text-center text-gray-500">Loading more posts...</div>
<div id="posts-end" class="hidden p-4 text-center text-gray-400 text-sm">No more posts</div>

<% if (isOwner) { %>
<script>
const API_URL = window.location.origin;

const editProfileBtn = document.getElementById('edit-profile-btn');
const editProfileModal = document.getElementById('edit-profile-modal');
const closeModalBtn = document.getElementById('close-modal-btn');
const cancelBtn = document.getElementById('cancel-btn');
const editProfileForm = document.getElementById('edit-profile-form');

const profileImageInput = document.getElementById('profile-image-input');
const backgroundImageInput = document.getElementById('background-image-input');
const profileImagePreview = document.getElementById('profile-image-preview');
const backgroundImagePreview = document.getElementById('background-image-preview');

let selectedProfileImage = null;
let selectedBackgroundImage = null;

editProfileBtn.addEventListener('click', () => {
    editProfileModal.classList.remove('hidden');
});

closeModalBtn.addEventListener('click', () => {
    editProfileModal.classList.add('hidden');
});

cancelBtn.addEventListener('click', () => {
    editProfileModal.classList.add('hidden');
});

editProfileModal.addEventListener('click', (e) => {
    if (e.target === editProfileModal) {
        editProfileModal.classList.add('hidden');
    }
});

profileImageInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
        selectedProfileImage = file;
        const reader = new FileReader();
        reader.onload = (e) => {
            profileImagePreview.innerHTML = `<img src="${e.target.result}" class="h-20 w-20 rounded-full object-cover">`;
        };
        reader.readAsDataURL(file);
    }
});

backgroundImageInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
        selectedBackgroundImage = file;
        const reader = new FileReader();
        reader.onload = (e) => {
            backgroundImagePreview.innerHTML = `<img src="${e.target.result}" class="h-20 w-full object-cover rounded">`;
        };
        reader.readAsDataURL(file);
    }
});

editProfileForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(editProfileForm);
    const username = formData.get('username');
    const email = formData.get('email');
    const bio = formData.get('bio');
    
    try {
        let profileImageUrl = null;
        let backgroundImageUrl = null;
        
        if (selectedProfileImage) {
            const imgFormData = new FormData();
            imgFormData.append('attachments', selectedProfileImage);
            
            const uploadResponse = await fetch(`${API_URL}/api/upload`, {
                method: 'POST',
                credentials: 'include',
                body: imgFormData
            });
            
            if (uploadResponse.ok) {
                const uploadData = await uploadResponse.json();
                profileImageUrl = uploadData.attachment_urls[0];
            }
        }
        
        if (selectedBackgroundImage) {
            const imgFormData = new FormData();
            imgFormData.append('attachments', selectedBackgroundImage);
            
            const uploadResponse = await fetch(`${API_URL}/api/upload`, {
                method: 'POST',
                credentials: 'include',
                body: imgFormData
            });
            
            if (uploadResponse.ok) {
                const uploadData = await uploadResponse.json();
                backgroundImageUrl = uploadData.attachment_urls[0];
            }
        }
        
        const updateData = {
            username,
            email,
            bio
        };
        
        if (profileImageUrl) updateData.profile_image = profileImageUrl;
        if (backgroundImageUrl) updateData.background_image = backgroundImageUrl;
        
        const response = await fetch(`${API_URL}/api/users/profile`, {
            method: 'PUT',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(updateData)
        });
        
        if (!response.ok) throw new Error('Failed to update profile');
        
        const data = await response.json();
        
        document.getElementById('username-display').textContent = data.user.username;
        document.getElementById('email-display').textContent = data.user.email;
        document.getElementById('bio-display').textContent = data.user.bio;
        
        if (data.user.profile_image) {
            document.getElementById('profile-image-display').src = data.user.profile_image;
        }
        
        if (data.user.background_image) {
            document.getElementById('background-image-display').src = data.user.background_image;
        }
        
        editProfileModal.classList.add('hidden');
        alert('Profile updated successfully!');
        
    } catch (error) {
        console.error('Update profile error:', error);
        alert('Failed to update profile. Please try again.');
    }
});
</script>
<% } %>

<script>
(function () {
    const postsContainer = document.getElementById('posts-container');
    const loadingEl = document.getElementById('posts-loading');
    const endEl = document.getElementById('posts-end');
    const LIMIT = 20;
    const profileUserId = '<%= profileUser.id %>';
    const isOwner = <%= isOwner %>;
    const endpoint = isOwner
        ? '/api/posts/user/html'
        : `/api/posts/user/${profileUserId}/html`;

    let page = 1;
    let loading = false;
    let hasMore = <%= posts.length >= 20 %>;

    const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) loadNextPage();
    }, { rootMargin: '200px' });
    observer.observe(document.getElementById('scroll-sentinel'));

    async function loadNextPage() {
        if (loading || !hasMore) return;
        loading = true;
        loadingEl.classList.remove('hidden');

        try {
            const response = await fetch(
                `${window.API_URL}${endpoint}?page=${page + 1}&limit=${LIMIT}`,
                { method: 'GET', credentials: 'include' }
            );
            if (!response.ok) throw new Error('Failed to load posts');
            const data = await response.json();

            if (data.html) {
                postsContainer.insertAdjacentHTML('beforeend', data.html);
                window.formatDates && window.formatDates(postsContainer);
            }
            page++;
            hasMore = data.hasMore;
            if (!hasMore) endEl.classList.remove('hidden');
        } catch (error) {
            console.error('Error loading more posts:', error);
        } finally {
            loading = false;
            loadingEl.classList.add('hidden');
        }
    }
}());
</script>
<% } %>