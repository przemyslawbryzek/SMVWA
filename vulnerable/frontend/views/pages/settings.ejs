<%- include('../../components/pageHeader', { title: 'Settings', backUrl: '/' }) %>
<div class="flex flex-col w-full">
    <h2 class="text-xl font-bold mb-4 p-2 border-b-1 border-stone-700">Account Settings</h2>
    <div id="settings-success" class="hidden mx-15 p-3 bg-green-900 text-green-200 rounded-lg text-sm"></div>
    <div id="settings-error" class="hidden mx-15 p-3 bg-red-900 text-red-200 rounded-lg text-sm"></div>
    <form id="settings-form" class="flex flex-col mx-15 gap-4 mt-2">
        <div>
            <label for="username" class="block text-sm font-medium text-gray-300">Username</label>
            <input type="text" name="username" id="settings-username" value="<%- user.username %>" required
                class="mt-1 p-2 w-full rounded-lg bg-black border border-stone-700 focus:outline-none focus:border-blue-500">
        </div>
        <div>
            <label for="email" class="block text-sm font-medium text-gray-300">Email</label>
            <input type="email" name="email" id="settings-email" value="<%- user.email %>" required
                class="mt-1 p-2 w-full rounded-lg bg-black border border-stone-700 focus:outline-none focus:border-blue-500">
        </div>
        <div>
            <label for="password" class="block text-sm font-medium text-gray-300">New Password</label>
            <input type="password" name="password" id="settings-password"
                placeholder="Leave blank to keep current password"
                class="mt-1 p-2 w-full rounded-lg bg-black border border-stone-700 focus:outline-none focus:border-blue-500">
        </div>
        <button type="submit" id="settings-save-btn"
            class="self-end px-5 py-2 rounded-full border-stone-700 border-1 cursor-pointer hover:bg-stone-900">Save Changes</button>
    </form>
</div>
<script>
const API_URL = window.location.origin;

document.getElementById('settings-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('settings-save-btn');
    const successEl = document.getElementById('settings-success');
    const errorEl   = document.getElementById('settings-error');
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    const body = {
        username: document.getElementById('settings-username').value.trim(),
        email:    document.getElementById('settings-email').value.trim(),
    };
    const password = document.getElementById('settings-password').value;
    if (password) body.password = password;

    btn.disabled = true;
    btn.textContent = 'Saving...';
    try {
        const response = await fetch(`${API_URL}/api/users/profile`, {
            method: 'PUT',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error('Failed to save settings');
        successEl.textContent = 'Settings saved successfully.';
        successEl.classList.remove('hidden');
        document.getElementById('settings-password').value = '';
    } catch (err) {
        errorEl.textContent = err.message || 'Failed to save settings.';
        errorEl.classList.remove('hidden');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
    }
});
</script>