<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>SMVWA</title>
</head>
<body class="bg-black">
    <div class="flex flex-row h-screen w-screen fixed">
        <div class="flex flex-col items-center text-white border-stone-700 border-r-1 h-full w-2/7 gap-2">
            <div class="m-2 hover:bg-stone-900 cursor-pointer p-3 rounded-full font-bold text-2xl">SMVWA</div>
            <a href="/" class="flex flex-row items-center w-1/3 gap-5 hover:bg-stone-900 cursor-pointer p-3 rounded-full">
                <img class="size-10" src="https://img.icons8.com/?size=100&id=2797&format=png&color=FFFFFF">
                <p>Home</p>
            </a>
            <a href="/explore" class="flex flex-row items-center w-1/3 gap-5 hover:bg-stone-900 cursor-pointer p-3 rounded-full">
                <img class="size-10" src="https://img.icons8.com/?size=100&id=7695&format=png&color=FFFFFF">
                <p>Explore</p>
            </a>
            <div class="flex flex-row items-center w-1/3 gap-5 opacity-50 cursor-not-allowed p-3 rounded-full" title="Chat – coming soon">
                <img class="size-10" src="https://img.icons8.com/?size=100&id=53388&format=png&color=FFFFFF">
                <p>Chat</p>
            </div>
            <a href="/profile" class="flex flex-row items-center w-1/3 gap-5 hover:bg-stone-900 cursor-pointer p-3 rounded-full">
                <img class="size-10" src="https://img.icons8.com/?size=100&id=15265&format=png&color=FFFFFF">
                <p>Profile</p>
            </a>
            <% if (user) { %>
            <div class="mt-auto mb-4 flex flex-row items-center hover:bg-stone-900 cursor-pointer p-3 rounded-full">   
                <img class="size-10 rounded-full ml-3" id="profile-img-sidebar" src="<%= user.profile_image || 'https://via.placeholder.com/40' %>">
                <div class="flex flex-col ml-5">
                    <p id="username" class=""><%- user.username %></p>
                    <p id="email" class="text-gray-500"><%- user.email %></p>
                </div>
                <p class="pl-30">...</p>

            </div>
            <% } %>
        </div>
        <div class="text-white h-full w-3/7 overflow-y-auto">
            <%- include(`./pages/${page}`) %>
        </div>
        <div class="text-white border-stone-700 border-l-1 h-full w-2/7 fixed right-0">
            <div class="relative m-4">
                <img class="size-5 absolute left-3 top-1/2 transform -translate-y-1/2" src="https://img.icons8.com/?size=100&id=7695&format=png&color=FFFFFF">
                <form method="GET" action="/explore">
                    <input type="text" name="q" placeholder="Search" class="p-2 pl-10 w-full rounded-full bg-black border border-stone-700 focus:outline-none focus:border-blue-500">
                </form>
            </div>
            <div class="flex flex-col m-4 p-4  rounded-lg border border-stone-700">  
                <p class="font-bold">WHO TO FOLLOW</p>
                <div>
                    <% if (suggestions && suggestions.length > 0) { %>
                        <% suggestions.forEach(suggestedUser => { %>
                            <%- include('../components/profileBar.ejs', { User: suggestedUser }) %>
                        <% }) %>
                    <% } else { %>
                        <p class="text-gray-500 mt-4">No suggestions available</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/actions.js"></script>
    <script>
      window.CURRENT_USER = <% if (user) { %>{ id: <%- user.id %>, role: 'user' }<% } else { %>null<% } %>;
    </script>
    <script>
      function formatDates(root) {
        (root || document).querySelectorAll('time[data-date]').forEach(el => {
          try {
            el.textContent = new Date(el.dataset.date).toLocaleDateString(undefined, {
              month: 'short', day: 'numeric', year: 'numeric'
            });
          } catch {}
        });
      }
      document.addEventListener('DOMContentLoaded', () => formatDates());
      window.formatDates = formatDates;
    </script>
</body>
</html>
